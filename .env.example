# ============ 项目公共代码对比 - 配置模板 ============
# 用法：复制为 .env 并修改

# 待对比的两个项目目录
PROJECT_A=D:\path\to\project-a
PROJECT_B=D:\path\to\project-b

# 报告输出目录
OUT_DIR=./output

# server.js 监听端口（仅 node src/server.js 时用到）
PORT=18899

# SIMILAR（相似/漂移）判定阈值，0~1
THRESHOLD=0.8

# 每个文件内嵌 diff 的最大行数
MAX_DIFF_LINES=300

# ---------- 过滤范围 ----------
# 过滤顺序：先按 INCLUDE 圈定范围（为空 = 全量），再按 EXCLUDE 剔除
# 语法：逗号分隔；* 不跨目录，** 跨目录，? 单字符；命中目录则包含/排除其下所有文件
# {PROJECT} 为项目名占位符，一条规则同时作用于两个项目
# 注意：规则锚定路径开头 —— 裸文件名只匹配项目根目录，
#      要匹配任意层级需写 **/前缀，如 **/pnpm-lock.yaml

# 白名单：只对比前端（{PROJECT}-vue 模块）
INCLUDE_DIRS={PROJECT}-vue/**

# 黑名单：剔除第三方包 / 生成物 / 草稿 / 按业务生成的数据
#   public/        富文本编辑器等第三方静态资源
#   .omo/          本地工具的会话产物
#   temp/          提示词与 UI 草稿
#   swagger/data   生成的 swagger.json（可达数万行）
#   src/@entities  由各自数据库实体生成的 .d.ts，两边必然不同
#   src/api        由各自 swagger 生成的接口封装，两边必然不同
#   tpl/menu       菜单模板数据，属业务配置
EXCLUDE_DIRS={PROJECT}-vue/public/**, {PROJECT}-vue/.omo/**, {PROJECT}-vue/temp/**, {PROJECT}-vue/swagger/data/**, {PROJECT}-vue/src/@entities/**, {PROJECT}-vue/src/api/**, {PROJECT}-vue/tpl/menu/**

# 文件级白名单（一般留空；需要时可在此精确点名文件）
INCLUDE_FILES=

# 文件级剔除：锁文件、缓存、二进制资源、环境配置与自动生成的声明
#   src/common/code.ext.*  码表定义，属业务数据
#   .env*                  各环境地址配置，属部署差异
#   auto-imports.d.ts      unplugin-auto-import 生成的自动导入声明
#   .eslintrc-auto-import.json  同上插件生成的 eslint 白名单
EXCLUDE_FILES=**/pnpm-lock.yaml, **/.eslintcache, **/*.png, **/*.jpg, **/*.jpeg, **/*.gif, **/*.webp, **/*.ico, **/*.woff, **/*.woff2, **/*.ttf, **/*.eot, **/.env*, **/auto-imports.d.ts, **/.eslintrc-auto-import.json, {PROJECT}-vue/src/common/code.ext.*
