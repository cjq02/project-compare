# ============ 项目公共代码对比 - 配置模板 ============
# 用法：复制为 .env 并修改

# 待对比的两个项目目录
PROJECT_A=D:\path\to\project-a
PROJECT_B=D:\path\to\project-b

# 报告输出目录
OUT_DIR=./output

# SIMILAR（相似/漂移）判定阈值，0~1
THRESHOLD=0.8

# 每个文件内嵌 diff 的最大行数
MAX_DIFF_LINES=300

# 排除规则：逗号分隔，支持通配符；{PROJECT} 为项目名占位符，一条规则同时作用于两边
EXCLUDE_DIRS=
# 示例（排除两边的彩票业务页面与生成数据）：
# EXCLUDE_DIRS={PROJECT}-vue/src/views/lottery/**, {PROJECT}-vue/swagger/data, {PROJECT}-vue/temp

# 单独按文件/目录排除（写法同上，与 EXCLUDE_DIRS 合并生效）
EXCLUDE_FILES=
