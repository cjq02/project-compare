# ============ 项目公共代码对比 - 配置模板 ============
# 用法：复制为 .env 并修改

# 待对比的两个项目目录
PROJECT_A=D:\path\to\project-a
PROJECT_B=D:\path\to\project-b

# 报告输出目录
OUT_DIR=./output

# server.js 监听端口（仅 node src/server.js 时用到）
PORT=18899

# SIMILAR（相似/漂移）判定阈值，0~1
THRESHOLD=0.8

# 每个文件内嵌 diff 的最大行数
MAX_DIFF_LINES=300

# ---------- IDE 对比 ----------
# 单击文件行时拉起的对比窗口：intellij | vscode | none
#   intellij  用 idea diff <A> <B>，diff 作为标签页插进已开的 IDEA
#   vscode    用 code --diff <A> <B>，开独立窗口
#   none      单击行为改为打开本报告的详情弹窗
DIFF_TOOL=intellij

# 以下留空则自动探测（扫描安装目录 / PATH）；探测不到或想指定版本时才填
# IDEA_EXE=C:\Program Files\JetBrains\IntelliJ IDEA 2026.1.1\bin\idea64.exe
# VSCODE_EXE=C:\Program Files\Microsoft VS Code\Code.exe

# ---------- 过滤范围 ----------
# 过滤顺序：先按 INCLUDE 圈定范围（为空 = 全量），再按 EXCLUDE 剔除
# 语法：* 不跨目录，** 跨目录，? 单字符；命中目录则包含/排除其下所有文件
# {PROJECT} 为项目名占位符，一条规则同时作用于两个项目
# 注意：规则锚定路径开头 —— 裸文件名只匹配项目根目录，
#      要匹配任意层级需写 **/ 前缀，如 **/pnpm-lock.yaml
#
# 【写法】KEY= 后每行一条规则，自动以逗号拼接，便于逐条配注释：
#     EXCLUDE_FILES=
#       **/pnpm-lock.yaml      # 锁文件
#       **/.eslintcache        # 缓存
# 块内空行与整行注释会被忽略；行内 # 是该条规则的说明。
# 单行逗号分隔的老写法同样支持。
# 顺序有意义：! 前缀可撤销排除，按书写顺序后者覆盖前者，
#            故"排除整个目录、只留其中一个文件"写为 dir/* 紧跟 !dir/keep.*

# 白名单：只对比前端（{PROJECT}-vue 模块），后端 api/service/web 本轮不参与
INCLUDE_DIRS={PROJECT}-vue/**

# 黑名单：剔除第三方包 / 生成物 / 草稿 / 按业务生成的数据
EXCLUDE_DIRS=
  {PROJECT}-vue/public/**         # 第三方编辑器与静态资源
  {PROJECT}-vue/.omo/**           # 本地工具的会话产物
  {PROJECT}-vue/temp/**           # 提示词与 UI 草稿
  {PROJECT}-vue/swagger/data/**   # 生成的 swagger.json（可达数万行）
  {PROJECT}-vue/src/@entities/**  # 由各自数据库实体生成的 .d.ts，两边必然不同
  {PROJECT}-vue/src/api/**        # 由各自 swagger 生成的接口封装，两边必然不同
  {PROJECT}-vue/tpl/menu/**       # 菜单模板数据，属业务配置

# 文件级白名单（一般留空；需要时可在此精确点名文件，写法同上）
INCLUDE_FILES=

# 文件级剔除：锁文件、缓存、二进制资源、环境配置与自动生成的声明
EXCLUDE_FILES=
  # 锁文件与缓存
  **/pnpm-lock.yaml
  **/.eslintcache
  # 二进制资源
  **/*.png
  **/*.jpg
  **/*.jpeg
  **/*.gif
  **/*.webp
  **/*.ico
  **/*.woff
  **/*.woff2
  **/*.ttf
  **/*.eot
  # 各环境地址配置，属部署差异
  **/.env*
  # unplugin-auto-import 生成
  **/*auto-imports.d.ts
  **/.eslintrc-auto-import*.json
  # 码表、枚举、全局变量等按业务生成，只保留 constants
  {PROJECT}-vue/src/common/*
  !{PROJECT}-vue/src/common/constants*
  # 由各自数据库实体生成的类型声明，两边必然不同
  {PROJECT}-vue/src/@types/entities.d.ts

# ---------- 路径别名（可选） ----------
# 两侧包段叫法不同时，用于把文件配成对。
# 语法：侧别(A|B)  锚点前缀  旧段 => 新段
#   - 只作用于指定的一侧（A、B 各自归一化，故必须带侧别）
#   - 只在锚点之后命中"整段"时才替换，前缀相同的段不会被误伤
#   - 只影响配对：不改文件内容，也不参与 INCLUDE/EXCLUDE 过滤
#
# 例：A 项目的 common 包在 B 项目里叫 base，
#     而 A 自己也有个 base 包 —— 全局段替换会撞车，故须带侧别与锚点。
#     A com/jiujie/{pkgpath}/  common => base
PATH_ALIAS=
