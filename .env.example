# ============ 项目公共代码对比 - 配置模板 ============
# 用法：复制为 .env 并修改

# 待对比的两个项目目录
PROJECT_A=D:\path\to\project-a
PROJECT_B=D:\path\to\project-b

# 报告输出目录
OUT_DIR=./output

# SIMILAR（相似/漂移）判定阈值，0~1
THRESHOLD=0.8

# 每个文件内嵌 diff 的最大行数
MAX_DIFF_LINES=300

# ---------- 过滤范围 ----------
# 过滤顺序：先按 INCLUDE 圈定范围（为空 = 全量），再按 EXCLUDE 剔除
# 语法：逗号分隔；* 不跨目录，** 跨目录，? 单字符；命中目录则包含/排除其下所有文件
# {PROJECT} 为项目名占位符，一条规则同时作用于两个项目

# 白名单（推荐：只对比框架层，忽略各自业务模块）
INCLUDE_DIRS=
# 示例（只看前端公共部分 + 后端 common）：
# INCLUDE_DIRS={PROJECT}-vue/src/utils/**, {PROJECT}-vue/src/components/**, {PROJECT}-vue/src/hooks/**, {PROJECT}-vue/src/layout/**, {PROJECT}-service/src/main/java/com/jiujie/common/**

# 黑名单（在白名单基础上再剔除）
EXCLUDE_DIRS=

# 单独按文件名过滤（写法同上，与对应的 DIRS 合并生效）
INCLUDE_FILES=
EXCLUDE_FILES=
